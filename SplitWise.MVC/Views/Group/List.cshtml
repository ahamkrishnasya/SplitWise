@model IEnumerable<SplitWise.MVC.Models.GroupViewModel>
@{
    ViewData["Title"] = "Groups";
	int num = 0;
}

<div class="text-center">
    <table>
        <thead>
            <tr>
                <th hidden></th>
                <th>S.No</th>
                <th>Group Name</th>
                <th>Description</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                @foreach (var group in Model)
                {
                    <td hidden>@group.GroupId</td>   
                    <td>@(num++)</td>
                    <td>@group.GroupName</td>
					<td>@group.Description</td>
                    <td><a asp-controller="Group" asp-action="Details" asp-route-id="@group.GroupId">View</a></td>
                }
            </tr>
        </tbody>
    </table>
</div>
