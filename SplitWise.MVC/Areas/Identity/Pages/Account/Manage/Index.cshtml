@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h4 class="fw-semibold mb-1">Profile</h4>
                    <p class="text-muted mb-4">
                        Manage your personal information
                    </p>

                    <partial name="_StatusMessage" for="StatusMessage" />

                    <form id="profile-form" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger small mb-3"
                             role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Username"
                                   class="form-control"
                                   disabled />
                            <label asp-for="Username"></label>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.PhoneNumber"
                                   class="form-control"
                                   autocomplete="tel" />
                            <label asp-for="Input.PhoneNumber"></label>
                            <span asp-validation-for="Input.PhoneNumber"
                                  class="text-danger small"></span>
                        </div>

                        <div class="row g-2">
                            <div class="col">
                                <div class="form-floating">
                                    <input asp-for="Input.FirstName"
                                           class="form-control" />
                                    <label asp-for="Input.FirstName"></label>
                                    <span asp-validation-for="Input.FirstName"
                                          class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col">
                                <div class="form-floating">
                                    <input asp-for="Input.LastName"
                                           class="form-control" />
                                    <label asp-for="Input.LastName"></label>
                                    <span asp-validation-for="Input.LastName"
                                          class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <button id="update-profile-button"
                                type="submit"
                                class="btn btn-primary w-100 mt-4">
                            Save changes
                        </button>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
